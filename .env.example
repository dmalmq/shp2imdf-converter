# FastAPI runtime
# HOST and PORT are NOT read by the app — there is no uvicorn.run() entry point.
# They record what to pass on the command line: uvicorn ... --host $HOST --port $PORT.
# Changing them alone has no effect; the dev scripts hardcode 8310 to match the
# frontend proxy in frontend/vite.config.ts, so change both together.
HOST=0.0.0.0
PORT=8310
LOG_LEVEL=INFO
# Must match the Vite dev-server port, or the browser's API calls are blocked.
CORS_ALLOWED_ORIGINS=http://localhost:5310

# Session management
SESSION_TTL_HOURS=24
# Oldest session is evicted once this many exist; one per colleague per upload.
MAX_SESSIONS=50
# filesystem survives restarts (incl. uvicorn --reload); memory is for throwaway runs.
SESSION_BACKEND=filesystem
SESSION_DATA_DIR=./data/sessions

# File handling
MAX_UPLOAD_MB=1024
TEMP_DATA_DIR=./data/tmp

# Regional 駅データ overlay for Illustrator placement (zip or folder of shapefiles).
# The shared PC already has this extract; pointing at it here means the browser
# never POSTs the 60 MB zip. Leave unset to hide "Load 駅データ". Add shapefile
# still works for other files. Do not commit the zip. Unpack cache is
# TEMP_DATA_DIR/reference-overlay/.
# REFERENCE_OVERLAY_PATH=C:\data\eki-data.zip

# Illustrator georeferencing cache
ILLUSTRATOR_CACHE_TTL_MINUTES=120
ILLUSTRATOR_CACHE_MAX_ENTRIES=20

# Geocoding (wizard address assist)
GEOCODER_PROVIDER=nominatim
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=shp2imdf-converter/1.0
GEOCODER_TIMEOUT_SECONDS=8
GEOCODER_CACHE_SECONDS=900
GEOCODER_CACHE_MAX_ENTRIES=512

# QGIS project export (styled .qgz download)
# Path to QGIS's bundled Python; if unset, common installs are auto-detected.
QGIS_PYTHON=C:\Program Files\QGIS 3.42.0\bin\python-qgis.bat
# Path to the generator script (defaults to tools/generate_qgis_project.py).
QGIS_GENERATOR_SCRIPT=./tools/generate_qgis_project.py
